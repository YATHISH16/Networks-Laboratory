    if (bind(sockid, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        close(sockid);
        exit(1);
    }

    printf("ARP Server started on port %d...\n", PORT);

    while (1)
    {
        client_len = sizeof(client_addr);
        memset(request_ip, 0, sizeof(request_ip));

        int n = recvfrom(sockid, request_ip,
                         sizeof(request_ip) - 1, 0,
                         (struct sockaddr *)&client_addr,
                         &client_len);

        if (n < 0)
        {
            perror("Receive failed");
            continue;
        }

        request_ip[n] = '\0';

        printf("\nRequest received for IP: %s\n", request_ip);

        if (strcmp(request_ip, "exit") == 0)
        {
            printf("Exit message received.\n");
            break;
        }

        FILE *fp = fopen("server_map.txt", "r");

        if (fp == NULL)
        {
            perror("Unable to open server_map.txt");

            char response[] = "SERVER_ERROR";
            sendto(sockid, response, strlen(response) + 1, 0,
                   (struct sockaddr *)&client_addr, client_len);
            continue;
        }

        int found = 0;

        while (fscanf(fp, "%49s %49s", file_ip, mac) == 2)
        {
            if (strcmp(request_ip, file_ip) == 0)
            {
                printf("IP found in server table\n");
                printf("MAC Address: %s\n", mac);

                sendto(sockid, mac, strlen(mac) + 1, 0,
                       (struct sockaddr *)&client_addr, client_len);

                found = 1;
                break;
            }
        }

        fclose(fp);

        if (found == 0)
        {
            printf("IP not found in server table\n");

            char response[] = "NOT_FOUND";

            sendto(sockid, response, strlen(response) + 1, 0,
                   (struct sockaddr *)&client_addr, client_len);
        }
    }

    close(sockid);
    return 0;
}


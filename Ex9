//client.c



#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 2048

/* Send all bytes */
int sendAll(int sock, const char *data, int length)
{
    int sent = 0;
    int n;

    while (sent < length)
    {
        n = send(sock, data + sent, length - sent, 0);

        if (n <= 0)
            return -1;

        sent += n;
    }

    return sent;
}

/* Send a newline-terminated request */
int sendRequest(int sock, const char *request)
{
    if (sendAll(sock, request, (int)strlen(request)) < 0)
        return -1;

    if (sendAll(sock, "\n", 1) < 0)
        return -1;

    return 0;
}

/* Receive one line */
int receiveLine(int sock, char *buffer, int size)
{
    int i = 0;
    int n;
    char ch;

    while (i < size - 1)
    {
        n = recv(sock, &ch, 1, 0);

        if (n <= 0)
            return n;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buffer[i++] = ch;
    }

    buffer[i] = '\0';

    return i;
}

/* Receive response until END */
int receiveResponse(int sock)
{
    char line[SIZE];
    int n;

    while (1)
    {
        n = receiveLine(sock, line, sizeof(line));

        if (n <= 0)
        {
            printf("Server disconnected.\n");
            return 0;
        }

        if (strcmp(line, "END") == 0)
            return 1;

        printf("%s\n", line);
    }
}

int main()
{
    int sockfd;
    struct sockaddr_in serverAddr;

    char username[32];
    char password[32];
    char request[SIZE];

    int choice;
    int answer;
    int i;
    int loggedIn = 0;

    /* Create TCP socket */
    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    memset(&serverAddr, 0, sizeof(serverAddr));

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(PORT);

    if (inet_pton(AF_INET, "127.0.0.1",
                  &serverAddr.sin_addr) != 1)
    {
        printf("Invalid server address.\n");
        close(sockfd);
        return 1;
    }

    /* Connect to server */
    if (connect(sockfd, (struct sockaddr *)&serverAddr,
                sizeof(serverAddr)) < 0)
    {
        perror("Connection failed");
        close(sockfd);
        return 1;
    }

    printf("Connected to Examination Server\n");

    /* Student login */
    printf("\n===== STUDENT LOGIN =====\n");

    printf("Username: ");

    if (scanf("%31s", username) != 1)
    {
        close(sockfd);
        return 1;
    }

    printf("Password: ");

    if (scanf("%31s", password) != 1)
    {
        close(sockfd);
        return 1;
    }

    snprintf(request, sizeof(request),
             "LOGIN %s %s", username, password);

    if (sendRequest(sockfd, request) < 0)
    {
        printf("Failed to send login request.\n");
        close(sockfd);
        return 1;
    }

    /* Check login response */
    {
        char line[SIZE];
        int n;
        int success = 0;

        while (1)
        {
            n = receiveLine(sockfd, line, sizeof(line));

            if (n <= 0)
            {
                printf("Server disconnected.\n");
                close(sockfd);
                return 1;
            }

            if (strcmp(line, "END") == 0)
                break;

            printf("%s\n", line);

            if (strcmp(line, "LOGIN SUCCESSFUL") == 0)
                success = 1;
        }

        if (!success)
        {
            printf("Login failed. Exiting.\n");
            close(sockfd);
            return 1;
        }
    }

    loggedIn = 1;

    /* Examination menu */
    while (loggedIn)
    {
        printf("\n===== ONLINE EXAMINATION =====\n");
        printf("1. View questions and take exam\n");
        printf("2. View final score\n");
        printf("3. Logout\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 1)
        {
            /* Request questions */
            if (sendRequest(sockfd, "QUESTIONS") < 0)
            {
                printf("Failed to send request.\n");
                break;
            }

            if (!receiveResponse(sockfd))
                break;

            printf("\nEnter answers from 1 to 4.\n");

            /*
               Build the submission request directly.
               Maximum command length is very small:
               "SUBMIT " + five single-digit answers.
            */
            {
                char submit[64];
                int used;

                used = snprintf(submit, sizeof(submit), "SUBMIT");

                if (used < 0 || used >= (int)sizeof(submit))
                {
                    printf("Unable to prepare submission.\n");
                    break;
                }

                for (i = 0; i < 5; i++)
                {
                    while (1)
                    {
                        printf("Answer for question %d: ", i + 1);

                        if (scanf("%d", &answer) != 1)
                        {
                            printf("Invalid input.\n");
                            close(sockfd);
                            return 1;
                        }

                        if (answer >= 1 && answer <= 4)
                            break;

                        printf("Enter a number from 1 to 4.\n");
                    }

                    used = snprintf(submit + strlen(submit),
                                    sizeof(submit) - strlen(submit),
                                    " %d", answer);

                    if (used < 0 ||
                        (size_t)used >= sizeof(submit) -
                                        strlen(submit))
                    {
                        printf("Unable to prepare submission.\n");
                        break;
                    }
                }

                if (i != 5)
                    break;

                /* Submit answers */
                if (sendRequest(sockfd, submit) < 0)
                {
                    printf("Failed to submit answers.\n");
                    break;
                }

                if (!receiveResponse(sockfd))
                    break;
            }
        }
        else if (choice == 2)
        {
            if (sendRequest(sockfd, "SCORE") < 0)
            {
                printf("Failed to request score.\n");
                break;
            }

            if (!receiveResponse(sockfd))
                break;
        }
        else if (choice == 3)
        {
            if (sendRequest(sockfd, "LOGOUT") == 0)
                receiveResponse(sockfd);

            loggedIn = 0;
        }
        else
        {
            printf("Invalid choice. Try again.\n");
        }
    }

    close(sockfd);

    printf("Client closed.\n");

    return 0;
}

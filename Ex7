#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 512
#define BOOKS 5
#define MAX_RECORDS 1000

struct Book
{
    int id;
    char title[50];
    int total;
    int available;
};

struct Record
{
    int clientPort;
    int requestId;
    char response[SIZE];
};

struct Book books[BOOKS] =
{
    {1, "C_Programming", 5, 5},
    {2, "Computer_Networks", 4, 4},
    {3, "Operating_Systems", 3, 3},
    {4, "DBMS", 4, 4},
    {5, "Cyber_Security", 2, 2}
};

struct Record records[MAX_RECORDS];
int recordCount = 0;

/* Log client activities with timestamps */
void logActivity(const char *message)
{
    FILE *fp = fopen("activity.log", "a");

    if (fp != NULL)
    {
        time_t now = time(NULL);
        char *timestamp = ctime(&now);

        if (timestamp != NULL)
        {
            fprintf(fp, "%s | %s", message, timestamp);
        }

        fclose(fp);
    }
}

/* Save book details to a file */
void saveBooks()
{
    FILE *fp = fopen("library.txt", "w");
    int i;

    if (fp == NULL)
    {
        perror("Unable to save library");
        return;
    }

    for (i = 0; i < BOOKS; i++)
    {
        fprintf(fp, "%d %s %d %d\n",
                books[i].id,
                books[i].title,
                books[i].total,
                books[i].available);
    }

    fclose(fp);
}

/* Load book details from a file */
void loadBooks()
{
    FILE *fp = fopen("library.txt", "r");
    int i;

    if (fp == NULL)
    {
        saveBooks();
        return;
    }

    for (i = 0; i < BOOKS; i++)
    {
        if (fscanf(fp, "%d %49s %d %d",
                   &books[i].id,
                   books[i].title,
                   &books[i].total,
                   &books[i].available) != 4)
        {
            printf("Invalid library data. Using default books.\n");

            fclose(fp);
            saveBooks();
            return;
        }
    }

    fclose(fp);
}

/* Find a book using its ID */
int findBook(int id)
{
    int i;

    for (i = 0; i < BOOKS; i++)
    {
        if (books[i].id == id)
        {
            return i;
        }
    }

    return -1;
}

/* Process a library request */
void processRequest(char *request, char *response)
{
    char operation[30];
    int id, index;
    int i;

    if (sscanf(request, "%29s", operation) != 1)
    {
        snprintf(response, SIZE, "ERROR Invalid request");
        return;
    }

    /* Display all books */
    if (strcmp(operation, "LIST") == 0)
    {
        response[0] = '\0';

        for (i = 0; i < BOOKS; i++)
        {
            char line[100];

            snprintf(line, sizeof(line),
                     "ID:%d Title:%s Available:%d/%d\n",
                     books[i].id,
                     books[i].title,
                     books[i].available,
                     books[i].total);

            if (strlen(response) + strlen(line) < SIZE)
            {
                strcat(response, line);
            }
        }

        return;
    }

    /* Read the book ID */
    if (sscanf(request, "%29s %d", operation, &id) != 2)
    {
        snprintf(response, SIZE, "ERROR Invalid book ID");
        return;
    }

    index = findBook(id);

    if (index == -1)
    {
        snprintf(response, SIZE, "ERROR Book not found");
        return;
    }

    /* Search for a book */
    if (strcmp(operation, "SEARCH") == 0)
    {
        snprintf(response, SIZE,
                 "Book: %s, Available: %d/%d",
                 books[index].title,
                 books[index].available,
                 books[index].total);
    }

    /* Issue a book */
    else if (strcmp(operation, "ISSUE") == 0)
    {
        if (books[index].available > 0)
        {
            books[index].available--;
            saveBooks();

            snprintf(response, SIZE,
                     "SUCCESS Book %s issued",
                     books[index].title);
        }
        else
        {
            snprintf(response, SIZE, "ERROR Book unavailable");
        }
    }

    /* Return a book */
    else if (strcmp(operation, "RETURN") == 0)
    {
        if (books[index].available < books[index].total)
        {
            books[index].available++;
            saveBooks();

            snprintf(response, SIZE,
                     "SUCCESS Book %s returned",
                     books[index].title);
        }
        else
        {
            snprintf(response, SIZE,
                     "ERROR All copies already available");
        }
    }

    else
    {
        snprintf(response, SIZE, "ERROR Unknown operation");
    }
}

/* Main server program */
int main()
{
    int sockfd;
    struct sockaddr_in serverAddr, clientAddr;
    socklen_t addrLen;

    char buffer[SIZE];
    char request[SIZE];
    char response[SIZE];

    int n, requestId, i, duplicate;

    /* Create UDP socket */
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    memset(&serverAddr, 0, sizeof(serverAddr));

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_addr.s_addr = INADDR_ANY;
    serverAddr.sin_port = htons(PORT);

    /* Bind socket to port */
    if (bind(sockfd, (struct sockaddr *)&serverAddr,
             sizeof(serverAddr)) < 0)
    {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    loadBooks();

    printf("Library UDP server running on port %d\n", PORT);
    printf("Waiting for client requests...\n");

    while (1)
    {
        addrLen = sizeof(clientAddr);

        n = recvfrom(sockfd, buffer, SIZE - 1, 0,
                     (struct sockaddr *)&clientAddr,
                     &addrLen);

        if (n < 0)
        {
            perror("Receive failed");
            continue;
        }

        buffer[n] = '\0';

        /*
          Packet format:
          requestID operation bookID

          Examples:
          1 LIST
          2 SEARCH 1
          3 ISSUE 2
          4 RETURN 2
        */

        if (sscanf(buffer, "%d %511[^\n]",
                   &requestId, request) != 2)
        {
            snprintf(response, SIZE, "ERROR Invalid packet");

            sendto(sockfd, response, strlen(response), 0,
                   (struct sockaddr *)&clientAddr, addrLen);

            continue;
        }

        duplicate = 0;

        /* Check whether the request was already processed */
        for (i = 0; i < recordCount; i++)
        {
            if (records[i].clientPort ==
                    ntohs(clientAddr.sin_port) &&
                records[i].requestId == requestId)
            {
                snprintf(response, SIZE, "%s",
                         records[i].response);

                duplicate = 1;
                break;
            }
        }

        if (!duplicate)
        {
            processRequest(request, response);

            /* Save response for duplicate-request handling */
            if (recordCount < MAX_RECORDS)
            {
                records[recordCount].clientPort =
                    ntohs(clientAddr.sin_port);

                records[recordCount].requestId = requestId;

                snprintf(records[recordCount].response, SIZE,
                         "%s", response);

                recordCount++;
            }

            /* Log the client request */
            snprintf(buffer, SIZE,
                     "ClientPort:%d RequestID:%d %.450s",
                     ntohs(clientAddr.sin_port),
                     requestId, request);

            logActivity(buffer);
        }

        /* Send response / application-level ACK */
        if (sendto(sockfd, response, strlen(response), 0,
                   (struct sockaddr *)&clientAddr,
                   addrLen) < 0)
        {
            perror("Send failed");
        }

        printf("\nRequest ID: %d\n", requestId);
        printf("Request: %s\n", request);
        printf("Response: %s\n", response);

        if (duplicate)
        {
            printf("Duplicate request detected."
                   " Previous response resent.\n");
        }
    }

    close(sockfd);
    return 0;
}


        exit(1);
    }

    fprintf(fp, "alice pass123\n");
    fprintf(fp, "bob pass123\n");

    fclose(fp);
}

/* Authenticate a student */
int authenticate(const char *username, const char *password)
{
    FILE *fp;
    char user[32], pass[32];
    int valid = 0;

    pthread_mutex_lock(&fileLock);

    fp = fopen(USERS_FILE, "r");

    if (fp != NULL)
    {
        while (fscanf(fp, "%31s %31s", user, pass) == 2)
        {
            if (strcmp(user, username) == 0 &&
                strcmp(pass, password) == 0)
            {
                valid = 1;
                break;
            }
        }

        fclose(fp);
    }

    pthread_mutex_unlock(&fileLock);

    return valid;
}

/* Record client activity with timestamp */
void logActivity(const char *ip, const char *username,
                 const char *activity)
{
    FILE *fp;
    time_t now = time(NULL);
    struct tm *tmInfo;
    char timestamp[30];

    tmInfo = localtime(&now);

    if (tmInfo != NULL)
        strftime(timestamp, sizeof(timestamp),
                 "%Y-%m-%d %H:%M:%S", tmInfo);
    else
        strcpy(timestamp, "Unknown time");

    pthread_mutex_lock(&fileLock);

    fp = fopen(LOG_FILE, "a");

    if (fp != NULL)
    {
        fprintf(fp, "%s | IP:%s | User:%s | %s\n",
                timestamp, ip, username, activity);

        fclose(fp);
    }

    pthread_mutex_unlock(&fileLock);
}

/* Send all examination questions */
void sendQuestions(int client)
{
    char response[SIZE];
    int i, j;

    response[0] = '\0';

    for (i = 0; i < 5; i++)
    {
        char line[300];

        snprintf(line, sizeof(line),
                 "Q%d: %s\n",
                 i + 1, questions[i].question);

        strncat(response, line,
                sizeof(response) - strlen(response) - 1);

        for (j = 0; j < 4; j++)
        {
            snprintf(line, sizeof(line),
                     "%d. %s\n",
                     j + 1, questions[i].option[j]);

            strncat(response, line,
                    sizeof(response) - strlen(response) - 1);
        }

        strncat(response, "\n",
                sizeof(response) - strlen(response) - 1);
    }

    sendResponse(client, response);
}

/* Save the student's result */
void saveResult(const char *username, int score)
{
    FILE *fp;
    time_t now = time(NULL);
    struct tm *tmInfo;
    char timestamp[30];

    tmInfo = localtime(&now);

    if (tmInfo != NULL)
        strftime(timestamp, sizeof(timestamp),
                 "%Y-%m-%d %H:%M:%S", tmInfo);
    else
        strcpy(timestamp, "Unknown time");

    pthread_mutex_lock(&fileLock);

    fp = fopen(RESULTS_FILE, "a");

    if (fp != NULL)
    {
        fprintf(fp, "%s %d/5 %s\n",
                username, score, timestamp);

        fclose(fp);
    }

    pthread_mutex_unlock(&fileLock);
}

/* Display the latest saved result for a student */
void viewScore(int client, const char *username)
{
    FILE *fp;
    char user[32], score[16], date[30], clockTime[30];
    char response[SIZE] = "No examination result found";
    int found = 0;

    pthread_mutex_lock(&fileLock);

    fp = fopen(RESULTS_FILE, "r");

    if (fp != NULL)
    {
        while (fscanf(fp, "%31s %15s %29s %29s",
                      user, score, date, clockTime) == 4)
        {
            if (strcmp(user, username) == 0)
            {
                snprintf(response, sizeof(response),
                         "Student: %s\nScore: %s\nDate: %s %s",
                         user, score, date, clockTime);

                found = 1;
            }
        }

        fclose(fp);
    }

    pthread_mutex_unlock(&fileLock);

    if (!found)
        strcpy(response, "No examination result found");

    sendResponse(client, response);
}

/* Handle one student connection */
void *handleClient(void *arg)
{
    struct Client *info = (struct Client *)arg;

    int client = info->socket;
    char ip[INET_ADDRSTRLEN];

    snprintf(ip, sizeof(ip), "%s", info->ip);
    free(info);

    char request[SIZE];
    char username[32] = "";
    char password[32];
    char command[20];
    char response[SIZE];

    int loggedIn = 0;
    int submitted = 0;
    int answers[5];
    int score, i, n;

    printf("Client connected: %s\n", ip);

    while (1)
    {
        n = receiveLine(client, request, sizeof(request));

        if (n <= 0)
            break;

        printf("[%s] Request: %s\n", ip, request);

        if (sscanf(request, "%19s", command) != 1)
        {
            sendResponse(client, "ERROR: Empty request");
            continue;
        }

        /* Login */
        if (strcmp(command, "LOGIN") == 0)
        {
            if (loggedIn)
            {
                sendResponse(client, "Already logged in");
                continue;
            }

            if (sscanf(request, "%19s %31s %31s",
                       command, username, password) != 3)
            {
                sendResponse(client,
                             "ERROR: Enter username and password");
                continue;
            }

            if (authenticate(username, password))
            {
                loggedIn = 1;

                sendResponse(client, "LOGIN SUCCESSFUL");

                logActivity(ip, username, "Login successful");

                printf("Student %s logged in\n", username);
            }
            else
            {
                username[0] = '\0';

                sendResponse(client,
                             "ERROR: Invalid username or password");

                logActivity(ip, "Unknown", "Failed login");
            }

            continue;
        }

        /* Every other command requires login */
        if (!loggedIn)
        {
            sendResponse(client, "ERROR: Please login first");
            continue;
        }

        /* Retrieve questions */
        if (strcmp(command, "QUESTIONS") == 0)
        {
            if (submitted)
            {
                sendResponse(client,
                             "You have already submitted the examination");
                continue;
            }

            sendQuestions(client);
            logActivity(ip, username, "Viewed examination questions");
        }

        /* Submit answers */
        else if (strcmp(command, "SUBMIT") == 0)
        {
            if (submitted)
            {
                sendResponse(client,
                             "ERROR: Examination already submitted");
                continue;
            }

            if (sscanf(request,
                       "%19s %d %d %d %d %d",
                       command,
                       &answers[0], &answers[1],
                       &answers[2], &answers[3],
                       &answers[4]) != 6)
            {
                sendResponse(client,
                             "ERROR: Submit exactly five answers");
                continue;
            }

            for (i = 0; i < 5; i++)
            {
                if (answers[i] < 1 || answers[i] > 4)
                    break;
            }

            if (i != 5)
            {
                sendResponse(client,
                             "ERROR: Each answer must be from 1 to 4");
                continue;
            }

            score = 0;

            for (i = 0; i < 5; i++)
            {
                if (answers[i] == questions[i].answer)
                    score++;
            }

            saveResult(username, score);
            submitted = 1;

            snprintf(response, sizeof(response),
                     "EXAMINATION SUBMITTED\nStudent: %s\nFinal Score: %d/5\nPercentage: %d%%",
                     username, score, score * 20);

            sendResponse(client, response);

            logActivity(ip, username, "Submitted examination");

            printf("Student %s scored %d/5\n",
                   username, score);
        }

        /* View result */
        else if (strcmp(command, "SCORE") == 0)
        {
            viewScore(client, username);
            logActivity(ip, username, "Viewed examination result");
        }

        /* Logout */
        else if (strcmp(command, "LOGOUT") == 0)
        {
            sendResponse(client, "Logout successful");

            logActivity(ip, username, "Logout");
            break;
        }

        else
        {
            sendResponse(client, "ERROR: Invalid command");
            logActivity(ip, username, "Invalid request");
        }
    }

    if (loggedIn)
        logActivity(ip, username, "Client disconnected");

    printf("Client disconnected: %s\n", ip);

    close(client);
    return NULL;
}


#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <arpa/inet.h>

#define PORT 8089
#define BUFFER_SIZE 1024

int main() {
    int sock;
    struct sockaddr_in server;
    char data[BUFFER_SIZE]; // Use a fixed stack buffer to prevent memory leaks

    // 1. Create Socket
    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("Socket creation failed");
        return 1;
    }

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = inet_addr("127.0.0.1");
    server.sin_port = htons(PORT);

    // 2. Connect to Server
    if (connect(sock, (struct sockaddr*)&server, sizeof(server)) < 0) {
        perror("Connection failed");
        close(sock);
        return 1;
    }
    printf("Connected to Server!\n"); // Fixed: A client connects to a server, not a client

    // 3. Communication Loop
    while (1) {
        printf("Enter message to send (type 'exit' to quit): ");
        
        // Read input safely up to BUFFER_SIZE
        if (fgets(data, BUFFER_SIZE, stdin) == NULL) break;
        
        // Remove trailing newline character added by fgets
        data[strcspn(data, "\n")] = '\0';

        // Exit condition
        if (strcmp(data, "exit") == 0) {
            break;
        }

        // Send data to server
        if (send(sock, data, strlen(data), 0) < 0) {
            perror("Send failed");
            break;
        }

        // Clear buffer and receive response
        memset(data, 0, BUFFER_SIZE);
        int bytes_received = recv(sock, data, BUFFER_SIZE - 1, 0);
        if (bytes_received <= 0) {
            printf("Server disconnected.\n");
            break;
        }

        printf("Server: %s\n", data);
    }

    // 4. Clean up
    close(sock);
    printf("Disconnected.\n");
    return 0;
}

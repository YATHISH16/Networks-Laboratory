#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 1024
#define MAX_TRAINS 5
#define MAX_BOOKINGS 1000

struct Train
{
    int id;
    char name[50];
    char source[30];
    char destination[30];
    int fare;
    int seats;
};

struct Booking
{
    int bookingId;
    int trainId;
    int seats;
    int active;
    char passenger[50];
};

struct Train trains[MAX_TRAINS] =
{
    {101, "Pandian_Express", "Chennai", "Madurai", 450, 50},
    {102, "Vaigai_Express", "Chennai", "Madurai", 400, 40},
    {103, "Cheran_Express", "Chennai", "Coimbatore", 500, 35},
    {104, "Rockfort_Express", "Chennai", "Trichy", 350, 30},
    {105, "Nellai_Express", "Chennai", "Tirunelveli", 550, 25}
};

struct Booking bookings[MAX_BOOKINGS];

int bookingCount = 0;
int nextBookingId = 1001;

/* Send all bytes of a message */
int sendAll(int sock, const char *data, int length)
{
    int sent = 0;
    int n;

    while (sent < length)
    {
        n = send(sock, data + sent, length - sent, 0);

        if (n <= 0)
            return -1;

        sent += n;
    }

    return sent;
}

/* Receive one line */
int receiveLine(int sock, char *buffer, int size)
{
    int i = 0;
    char ch;
    int n;

    while (i < size - 1)
    {
        n = recv(sock, &ch, 1, 0);

        if (n <= 0)
            return n;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buffer[i++] = ch;
    }

    buffer[i] = '\0';
    return i;
}

/* Send a response ending with END */
void sendResponse(int sock, const char *message)
{
    sendAll(sock, message, strlen(message));
    sendAll(sock, "\nEND\n", 5);
}

/* Log client activities */
void logActivity(const char *message, const char *ip)
{
    FILE *fp = fopen("railway.log", "a");
    time_t now = time(NULL);
    char *timestamp = ctime(&now);

    if (fp != NULL)
    {
        fprintf(fp, "IP: %s | %s | %s",
                ip, message,
                timestamp ? timestamp : "Unknown time\n");

        fclose(fp);
    }
}

/* Save train seat availability */
void saveTrains()
{
    FILE *fp = fopen("trains.txt", "w");
    int i;

    if (fp == NULL)
        return;

    for (i = 0; i < MAX_TRAINS; i++)
    {
        fprintf(fp, "%d %s %s %s %d %d\n",
                trains[i].id,
                trains[i].name,
                trains[i].source,
                trains[i].destination,
                trains[i].fare,
                trains[i].seats);
    }

    fclose(fp);
}

/* Load train details */
void loadTrains()
{
    FILE *fp = fopen("trains.txt", "r");
    int i;

    if (fp == NULL)
    {
        saveTrains();
        return;
    }

    for (i = 0; i < MAX_TRAINS; i++)
    {
        if (fscanf(fp, "%d %49s %29s %29s %d %d",
                   &trains[i].id,
                   trains[i].name,
                   trains[i].source,
                   trains[i].destination,
                   &trains[i].fare,
                   &trains[i].seats) != 6)
        {
            printf("Invalid train database. Using defaults.\n");
            fclose(fp);
            saveTrains();
            return;
        }
    }

    fclose(fp);
}

/* Save bookings */
void saveBookings()
{
    FILE *fp = fopen("bookings.txt", "w");
    int i;

    if (fp == NULL)
        return;

    for (i = 0; i < bookingCount; i++)
    {
        fprintf(fp, "%d %d %d %d %s\n",
                bookings[i].bookingId,
                bookings[i].trainId,
                bookings[i].seats,
                bookings[i].active,
                bookings[i].passenger);
    }

    fclose(fp);
}

/* Load bookings */
void loadBookings()
{
    FILE *fp = fopen("bookings.txt", "r");

    if (fp == NULL)
        return;

    bookingCount = 0;

    while (bookingCount < MAX_BOOKINGS)
    {
        struct Booking b;

        if (fscanf(fp, "%d %d %d %d %49s",
                   &b.bookingId,
                   &b.trainId,
                   &b.seats,
                   &b.active,
                   b.passenger) != 5)
            break;

        bookings[bookingCount++] = b;

        if (b.bookingId >= nextBookingId)
            nextBookingId = b.bookingId + 1;
    }

    fclose(fp);
}

/* Find train */
int findTrain(int id)
{
    int i;

    for (i = 0; i < MAX_TRAINS; i++)
    {
        if (trains[i].id == id)
            return i;
    }

    return -1;
}

/* Find booking */
int findBooking(int id)
{
    int i;

    for (i = 0; i < bookingCount; i++)
    {
        if (bookings[i].bookingId == id)
            return i;
    }

    return -1;
}

/* Process client request */
void processRequest(int client, char *request, const char *ip)
{
    char command[20];
    char response[SIZE];
    char source[30], destination[30], passenger[50];
    int trainId, seats, bookingId, index, i;

    if (sscanf(request, "%19s", command) != 1)
    {
        sendResponse(client, "ERROR: Empty request");
        return;
    }

    /* Display all trains */
    if (strcmp(command, "LIST") == 0)
    {
        snprintf(response, sizeof(response),
                 "ID   TRAIN              SOURCE      DESTINATION  FARE  SEATS\n");

        for (i = 0; i < MAX_TRAINS; i++)
        {
            char line[200];

            snprintf(line, sizeof(line),
                     "%d  %s  %s  %s  Rs.%d  %d\n",
                     trains[i].id,
                     trains[i].name,
                     trains[i].source,
                     trains[i].destination,
                     trains[i].fare,
                     trains[i].seats);

            if (strlen(response) + strlen(line) < sizeof(response) - 10)
                strcat(response, line);
        }

        sendResponse(client, response);
        logActivity("Viewed train list", ip);
        return;
    }

    /* Search trains by route */
    if (strcmp(command, "SEARCH") == 0)
    {
        if (sscanf(request, "%19s %29s %29s",
                   command, source, destination) != 3)
        {
            sendResponse(client,
                         "ERROR: Enter source and destination");
            return;
        }

        response[0] = '\0';

        for (i = 0; i < MAX_TRAINS; i++)
        {
            if (strcasecmp(trains[i].source, source) == 0 &&
                strcasecmp(trains[i].destination, destination) == 0)
            {
                char line[200];

                snprintf(line, sizeof(line),
                         "Train ID: %d | Name: %s | Fare: Rs.%d | Seats: %d\n",
                         trains[i].id, trains[i].name,
                         trains[i].fare, trains[i].seats);

                if (strlen(response) + strlen(line) < sizeof(response) - 10)
                    strcat(response, line);
            }
        }

        if (response[0] == '\0')
            snprintf(response, sizeof(response),
                     "No trains found for this route");

        sendResponse(client, response);
        logActivity("Searched trains", ip);
        return;
    }

    /* Book a ticket */
    if (strcmp(command, "BOOK") == 0)
    {
        if (sscanf(request, "%19s %d %d %49s",
                   command, &trainId, &seats, passenger) != 4)
        {
            sendResponse(client, "ERROR: Invalid booking request");
            return;
        }

        index = findTrain(trainId);

        if (index == -1)
        {
            sendResponse(client, "ERROR: Invalid train ID");
            return;
        }

        if (seats <= 0)
        {
            sendResponse(client, "ERROR: Seat count must be positive");
            return;
        }

        if (seats > trains[index].seats)
        {
            sendResponse(client, "ERROR: Not enough seats available");
            return;
        }

        if (bookingCount >= MAX_BOOKINGS)
        {
            sendResponse(client, "ERROR: Booking database is full");
            return;
        }

        bookings[bookingCount].bookingId = nextBookingId++;
        bookings[bookingCount].trainId = trainId;
        bookings[bookingCount].seats = seats;
        bookings[bookingCount].active = 1;

        snprintf(bookings[bookingCount].passenger,
                 sizeof(bookings[bookingCount].passenger),
                 "%s", passenger);

        bookingId = bookings[bookingCount].bookingId;
        bookingCount++;

        trains[index].seats -= seats;

        saveBookings();
        saveTrains();

        snprintf(response, sizeof(response),
                 "BOOKING SUCCESSFUL\nBooking ID: %d\nPassenger: %s\nTrain: %s\nSeats: %d\nTotal Fare: Rs.%d",
                 bookingId, passenger,
                 trains[index].name, seats,
                 seats * trains[index].fare);

        sendResponse(client, response);
        logActivity("Booked tickets", ip);
        return;
    }

    /* Cancel a booking */
    if (strcmp(command, "CANCEL") == 0)
    {
        if (sscanf(request, "%19s %d",
                   command, &bookingId) != 2)
        {
            sendResponse(client, "ERROR: Enter booking ID");
            return;
        }

        index = findBooking(bookingId);

        if (index == -1)
        {
            sendResponse(client, "ERROR: Booking not found");
            return;
        }

        if (!bookings[index].active)
        {
            sendResponse(client, "ERROR: Booking already cancelled");
            return;
        }

        trainId = findTrain(bookings[index].trainId);

        if (trainId == -1)
        {
            sendResponse(client, "ERROR: Train not found");
            return;
        }

        trains[trainId].seats += bookings[index].seats;
        bookings[index].active = 0;

        saveBookings();
        saveTrains();

        snprintf(response, sizeof(response),
                 "Booking %d cancelled successfully",
                 bookingId);

        sendResponse(client, response);
        logActivity("Cancelled booking", ip);
        return;
    }

    /* View booking status */
    if (strcmp(command, "STATUS") == 0)
    {
        if (sscanf(request, "%19s %d",
                   command, &bookingId) != 2)
        {
            sendResponse(client, "ERROR: Enter booking ID");
            return;
        }

        index = findBooking(bookingId);

        if (index == -1)
        {
            sendResponse(client, "ERROR: Booking not found");
            return;
        }

        snprintf(response, sizeof(response),
                 "Booking ID: %d\nPassenger: %s\nTrain ID: %d\nSeats: %d\nStatus: %s",
                 bookings[index].bookingId,
                 bookings[index].passenger,
                 bookings[index].trainId,
                 bookings[index].seats,
                 bookings[index].active ? "CONFIRMED" : "CANCELLED");

        sendResponse(client, response);
        logActivity("Checked booking status", ip);
        return;
    }

    sendResponse(client, "ERROR: Invalid command");
    logActivity("Invalid request", ip);
}


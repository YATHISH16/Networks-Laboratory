/* Send the complete message */
int sendAll(int sock, const char *data, int length)
{
    int sent = 0;
    int n;

    while (sent < length)
    {
        n = send(sock, data + sent, length - sent,
                 MSG_NOSIGNAL);

        if (n <= 0)
            return -1;

        sent += n;
    }

    return sent;
}

/* Receive a newline-terminated request */
int receiveLine(int sock, char *buffer, int size)
{
    int i = 0;
    char ch;
    int n;

    while (i < size - 1)
    {
        n = recv(sock, &ch, 1, 0);

        if (n <= 0)
            return n;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buffer[i++] = ch;
    }

    buffer[i] = '\0';
    return i;
}

/* Send a response ending with END */
int sendResponse(int sock, const char *message)
{
    if (sendAll(sock, message, strlen(message)) < 0)
        return -1;

    if (sendAll(sock, "\nEND\n", 5) < 0)
        return -1;

    return 0;
}

/* Create sample accounts if users.txt does not exist */
void initializeUsers()
{
    FILE *fp = fopen(USERS_FILE, "r");

    if (fp != NULL)
    {
        fclose(fp);
        return;
    }

    fp = fopen(USERS_FILE, "w");

    if (fp == NULL)
    {

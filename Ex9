#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define BUFFER_SIZE 4096
#define NAME_SIZE 256
#define SERVER_IP "172.16.16.200" //"127.0.0.1"

int send_all(int sock, const void *data, size_t size)
{
    const char *p = data;
    size_t sent = 0;

    while (sent < size)
    {
        ssize_t n = send(sock, p + sent, size - sent, 0);

        if (n <= 0)
            return -1;

        sent += n;
    }

    return 0;
}

int recv_exact(int sock, void *data, size_t size)
{
    char *p = data;
    size_t received = 0;

    while (received < size)
    {
        ssize_t n = recv(sock, p + received,
                         size - received, 0);

        if (n <= 0)
            return -1;

        received += n;
    }

    return 0;
}

int read_line(int sock, char *buf, size_t size)
{
    size_t i = 0;
    char c;

    while (i < size - 1)
    {
        ssize_t n = recv(sock, &c, 1, 0);

        if (n <= 0)
            return -1;

        if (c == '\n')
            break;

        buf[i++] = c;
    }

    buf[i] = '\0';
    return 0;
}

int valid_filename(const char *name)
{
    if (name[0] == '\0' || strcmp(name, ".") == 0 ||
        strcmp(name, "..") == 0)
        return 0;

    if (strchr(name, '/') != NULL ||
        strchr(name, '\\') != NULL)
        return 0;

    return 1;
}

int receive_file(int sock, FILE *fp, long long size)
{
    char buffer[BUFFER_SIZE];

    while (size > 0)
    {
        size_t amount = size > BUFFER_SIZE
                        ? BUFFER_SIZE : (size_t)size;

        if (recv_exact(sock, buffer, amount) < 0)
            return -1;

        if (fwrite(buffer, 1, amount, fp) != amount)
            return -1;

        size -= amount;
    }

    return 0;
}

int main()
{
    int socid, ch;
    struct sockaddr_in addr;
    char filename[NAME_SIZE];
    char line[128];

    socid = socket(AF_INET, SOCK_STREAM, 0);

    if (socid < 0)
    {
        perror("Socket");
        return 1;
    }

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);

    if (inet_pton(AF_INET, SERVER_IP, &addr.sin_addr) <= 0)
    {
        printf("Invalid server IP address\n");
        close(socid);
        return 1;
    }

    if (connect(socid, (struct sockaddr *)&addr,
                sizeof(addr)) < 0)
    {
        perror("Connection failed");
        close(socid);
        return 1;
    }

    printf("Enter your choice:\n");
    printf("1. Retrieve file from server\n");
    printf("2. Transfer file to server\n");
    printf("Choice: ");

    if (scanf("%d", &ch) != 1 || (ch != 1 && ch != 2))
    {
        printf("Invalid choice\n");
        close(socid);
        return 1;
    }

    printf("Enter file name: ");

    if (scanf("%255s", filename) != 1 ||
        !valid_filename(filename))
    {
        printf("Invalid file name\n");
        close(socid);
        return 1;
    }

    /* Send the choice and filename as newline-terminated text. */
    snprintf(line, sizeof(line), "%d\n", ch);

    if (send_all(socid, line, strlen(line)) < 0 ||
        send_all(socid, filename, strlen(filename)) < 0 ||
        send_all(socid, "\n", 1) < 0)
    {
        printf("Failed to send request\n");
        close(socid);
        return 1;
    }

    if (ch == 1)
    {
        /* Retrieve a file from the server. */
        if (read_line(socid, line, sizeof(line)) < 0)
        {
            printf("Server disconnected\n");
            close(socid);
            return 1;
        }

        if (strncmp(line, "OK ", 3) != 0)
        {
            printf("File not found on server\n");
            close(socid);
            return 1;
        }

        char *end;
        long long size = strtoll(line + 3, &end, 10);

        if (end == line + 3 || *end != '\0' || size < 0)
        {
            printf("Invalid file size from server\n");
            close(socid);
            return 1;
        }

        FILE *fp = fopen(filename, "wb");

        if (fp == NULL)
        {
            perror("Cannot create local file");
            close(socid);
            return 1;
        }

        if (receive_file(socid, fp, size) < 0)
        {
            printf("File transfer incomplete\n");
            fclose(fp);
            remove(filename);
            close(socid);
            return 1;
        }

        if (fclose(fp) != 0)
        {
            perror("File write error");
            close(socid);
            return 1;
        }

        printf("File retrieved successfully (%lld bytes).\n", size);
    }
    else
    {
        /* Transfer a local file to the server. */
        FILE *fp = fopen(filename, "rb");

        if (fp == NULL)
        {
            printf("File does not exist locally\n");
            close(socid);
            return 1;
        }

        if (fseek(fp, 0, SEEK_END) != 0)
        {
            fclose(fp);
            close(socid);
            return 1;
        }

        long long size = (long long)ftell(fp);

        if (size < 0 || fseek(fp, 0, SEEK_SET) != 0)
        {
            fclose(fp);
            close(socid);
            return 1;
        }

        snprintf(line, sizeof(line), "%lld\n", size);

        if (send_all(socid, line, strlen(line)) < 0 ||
            read_line(socid, line, sizeof(line)) < 0 ||
            strcmp(line, "OK") != 0)
        {
            printf("Server cannot accept the file\n");
            fclose(fp);
            close(socid);
            return 1;
        }

        char buffer[BUFFER_SIZE];
        long long remaining = size;
        int success = 1;

        while (remaining > 0)
        {
            size_t amount = remaining > BUFFER_SIZE
                            ? BUFFER_SIZE : (size_t)remaining;

            size_t n = fread(buffer, 1, amount, fp);

            if (n != amount || send_all(socid, buffer, n) < 0)
            {
                success = 0;
                break;
            }

            remaining -= n;
        }

        fclose(fp);

        if (!success ||
            read_line(socid, line, sizeof(line)) < 0 ||
            strcmp(line, "OK") != 0)
        {
            printf("File transfer failed\n");
            close(socid);
            return 1;
        }

        printf("File transferred successfully (%lld bytes).\n", size);
    }

    close(socid);
    return 0;
}


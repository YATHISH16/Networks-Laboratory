#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>     // Required for strcmp and memset
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8089
#define BUFFER_SIZE 1024

int main() {
    int ser_sock, cli_sock;
    struct sockaddr_in server_addr, client_addr;
    char data[BUFFER_SIZE]; // Stack array avoids pointer bugs and leaks

    // 1. Create Socket
    ser_sock = socket(AF_INET, SOCK_STREAM, 0);
    if (ser_sock < 0) {
        perror("Socket creation failed");
        return 1;
    }

    // Allow quick port reuse (prevents "Address already in use" errors)
    int opt = 1;
    setsockopt(ser_sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    // 2. Bind Socket
    if (bind(ser_sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(ser_sock);
        return 1;
    }

    // 3. Listen
    if (listen(ser_sock, 1) < 0) {
        perror("Listen failed");
        close(ser_sock);
        return 1;
    }
    printf("[Server] Waiting for incoming connections on port %d...\n", PORT);

    // 4. Accept Connection
    socklen_t address_len = sizeof(client_addr);
    cli_sock = accept(ser_sock, (struct sockaddr*)&client_addr, &address_len);
    if (cli_sock < 0) {
        perror("Accept failed");
        close(ser_sock);
        return 1;
    }
    printf("[Server] Client connected successfully!\n");

    // 5. Echo Loop
    while (1) {
        // Clear the buffer before receiving data
        memset(data, 0, BUFFER_SIZE);

        // Receive data from client (Leaves 1 byte for null-terminator)
        int bytes_received = recv(cli_sock, data, BUFFER_SIZE - 1, 0);
        
        // Check if client disconnected or an error occurred
        if (bytes_received <= 0) {
            printf("[Server] Client disconnected.\n");
            break;
        }

        printf("Client: %s\n", data);

        // Echo the exact same data back to the client
        if (send(cli_sock, data, strlen(data), 0) < 0) {
            perror("Send failed");
            break;
        }
    }

    // 6. Clean up
    close(cli_sock);
    close(ser_sock);
    printf("[Server] Sockets closed.\n");
    return 0;
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5050
#define MAX_CACHE 100

int main()
{
    int sockid;
    struct sockaddr_in server_addr;
    socklen_t server_len;

    char request_ip[50];
    char response[50];

    /* Client-side ARP cache using arrays */
    char cache_ip[MAX_CACHE][50];
    char cache_mac[MAX_CACHE][50];
    int cache_count = 0;

    sockid = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockid < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);

    inet_pton(AF_INET, "127.0.0.1",
              &server_addr.sin_addr);

    server_len = sizeof(server_addr);

    while (1)
    {
        printf("\nEnter IP address (or exit): ");
        scanf("%49s", request_ip);

        if (strcmp(request_ip, "exit") == 0)
        {
            sendto(sockid, request_ip,
                   strlen(request_ip) + 1, 0,
                   (struct sockaddr *)&server_addr,
                   server_len);
            break;
        }

        int found = 0;

        /* Step 1: Search the client cache */
        for (int i = 0; i < cache_count; i++)
        {
            if (strcmp(request_ip, cache_ip[i]) == 0)
            {
                printf("IP found in client cache\n");
                printf("MAC Address: %s\n", cache_mac[i]);
                found = 1;
                break;
            }
        }

        /* Step 2: Contact server if cache miss */
        if (found == 0)
        {
            printf("IP not found in client cache\n");
            printf("Requesting server...\n");

            sendto(sockid, request_ip,
                   strlen(request_ip) + 1, 0,
                   (struct sockaddr *)&server_addr,
                   server_len);

            memset(response, 0, sizeof(response));

            int n = recvfrom(sockid, response,
                             sizeof(response) - 1, 0,
                             NULL, NULL);

            if (n < 0)
            {
                perror("Receive failed");
                continue;
            }

            response[n] = '\0';

            if (strcmp(response, "NOT_FOUND") == 0)
            {
                printf("IP not found in server table\n");
            }
            else if (strcmp(response, "SERVER_ERROR") == 0)
            {
                printf("Server could not read its mapping file\n");
            }
            else
            {
                printf("MAC Address: %s\n", response);

                /* Step 3: Store the mapping in the cache */
                if (cache_count < MAX_CACHE)
                {
                    strcpy(cache_ip[cache_count], request_ip);
                    strcpy(cache_mac[cache_count], response);
                    cache_count++;

                    printf("Mapping stored in client cache\n");
                }
                else
                {
                    printf("Client cache is full\n");
                }
            }
        }
    }
    close(sockid);

    return 0;
}


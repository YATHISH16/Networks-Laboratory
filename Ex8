#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 1024

int main()
{
    int socid;
    struct sockaddr_in addr;
    char msg[SIZE];
    ssize_t n;

    // Create socket
    socid = socket(AF_INET, SOCK_STREAM, 0);

    if (socid < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    // Configure server address
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);

    if (inet_pton(AF_INET, "127.0.0.1",
                  &addr.sin_addr) != 1)
    {
        printf("Invalid IP address\n");
        close(socid);
        return 1;
    }

    // Connect to server
    if (connect(socid, (struct sockaddr *)&addr,
                sizeof(addr)) < 0)
    {
        perror("Connection failed");
        close(socid);
        return 1;
    }

    printf("Connected to server\n");

    // Chat loop
    while (1)
    {
        printf("Client: ");

        if (fgets(msg, SIZE, stdin) == NULL)
            break;

        msg[strcspn(msg, "\n")] = '\0';

        if (send(socid, msg, strlen(msg), 0) < 0)
        {
            perror("Send failed");
            break;
        }

        if (strcmp(msg, "exit") == 0)
            break;

        n = recv(socid, msg, SIZE - 1, 0);

        if (n <= 0)
        {
            if (n == 0)
                printf("Server disconnected\n");
            else
                perror("Receive failed");

            break;
        }

        msg[n] = '\0';
        printf("Server: %s\n", msg);

        if (strcmp(msg, "exit") == 0)
            break;
    }

    close(socid);
    printf("Client closed\n");

    return 0;
}


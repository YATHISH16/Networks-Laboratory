#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int stop;
    int bus;
} StopBusPair;

int comparePairs(const void* a, const void* b) {
    StopBusPair* p1 = (StopBusPair*)a;
    StopBusPair* p2 = (StopBusPair*)b;
    return p1->stop - p2->stop;
}

int numBusesToDestination(int** routes, int routesSize, int* routesColSize, int source, int target) {
    if (source == target) {
        return 0;
    }

    int totalElements = 0;
    for (int i = 0; i < routesSize; i++) {
        totalElements += routesColSize[i];
    }

    StopBusPair* pairs = (StopBusPair*)malloc(totalElements * sizeof(StopBusPair));
    int pairIdx = 0;
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            pairs[pairIdx].stop = routes[i][j];
            pairs[pairIdx].bus = i;
            pairIdx++;
        }
    }

    qsort(pairs, totalElements, sizeof(StopBusPair), comparePairs);

    void findStopRange(int stop, int* start, int* end) {
        int low = 0, high = totalElements - 1;
        int foundIdx = -1;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (pairs[mid].stop == stop) {
                foundIdx = mid;
                break;
            } else if (pairs[mid].stop < stop) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
        if (foundIdx == -1) {
            *start = -1;
            *end = -1;
            return;
        }
        int s = foundIdx;
        while (s > 0 && pairs[s - 1].stop == stop) s--;
        int e = foundIdx;
        while (e < totalElements - 1 && pairs[e + 1].stop == stop) e++;
        *start = s;
        *end = e;
    }

    bool* visitedBuses = (bool*)calloc(routesSize, sizeof(bool));
    bool* visitedPairs = (bool*)calloc(totalElements, sizeof(bool));
    int* queue = (int*)malloc(routesSize * sizeof(int));
    int head = 0, tail = 0;

    int srcStart, srcEnd;
    findStopRange(source, &srcStart, &srcEnd);
    if (srcStart == -1) {
        free(pairs); free(visitedBuses); free(visitedPairs); free(queue);
        return -1;
    }

    for (int i = srcStart; i <= srcEnd; i++) {
        int b = pairs[i].bus;
        if (!visitedBuses[b]) {
            visitedBuses[b] = true;
            queue[tail++] = b;
        }
    }

    int busCount = 1;
    while (head < tail) {
        int levelSize = tail - head;
        for (int i = 0; i < levelSize; i++) {
            int currBus = queue[head++];
            for (int j = 0; j < routesColSize[currBus]; j++) {
                int stop = routes[currBus][j];

                if (stop == target) {
                    free(pairs); free(visitedBuses); free(visitedPairs); free(queue);
                    return busCount;
                }
                int st, ed;
                findStopRange(stop, &st, &ed);
                if (st != -1) {
                    for (int k = st; k <= ed; k++) {
                        if (!visitedPairs[k]) {
                            visitedPairs[k] = true;
                            int nextBus = pairs[k].bus;
                            if (!visitedBuses[nextBus]) {
                                visitedBuses[nextBus] = true;
                                queue[tail++] = nextBus;
                            }
                        }
                    }
                }
            }
        }
        busCount++;
    }
    free(pairs);
    free(visitedBuses);
    free(visitedPairs);
    free(queue);

    return -1; 
}



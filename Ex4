#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

#define INF 1e9

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    bool* visited = (bool*)calloc((n + 1), sizeof(bool));
   
    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
    }
    dist[k] = 0; // Distance to the source node itself is 0

    for (int count = 1; count <= n; count++) {
        int u = -1;
        int minDist = INF;
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < minDist) {
                minDist = dist[i];
                u = i;
            }
        }
        if (u == -1) break;
        visited[u] = true;
        for (int i = 0; i < timesSize; i++) {
            int source = times[i][0];
            int target = times[i][1];
            int travelTime = times[i][2];

            if (source == u && !visited[target]) {
                if (dist[u] + travelTime < dist[target]) {
                    dist[target] = dist[u] + travelTime;
                }
            }
        }
    }
    int maxDelay = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            free(dist);
            free(visited);
            return -1;
        }
        if (dist[i] > maxDelay) {
            maxDelay = dist[i];
        }
    }
    free(dist);
    free(visited);

    return maxDelay;
}



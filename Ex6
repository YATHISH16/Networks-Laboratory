#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 1024

int main()
{
    int socid, childid;
    struct sockaddr_in addr;
    char msg[SIZE];
    int n;

    // Create socket
    socid = socket(AF_INET, SOCK_STREAM, 0);

    if (socid < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    // Fill server address structure
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);
    addr.sin_addr.s_addr = htonl(INADDR_ANY);

    // Bind socket to IP address and port
    if (bind(socid, (struct sockaddr *)&addr, sizeof(addr)) < 0)
    {
        printf("Bind failed\n");
        close(socid);
        return 1;
    }

    // Put socket into listening state
    if (listen(socid, 5) < 0)
    {
        printf("Listen failed\n");
        close(socid);
        return 1;
    }

    printf("Listening to port %d...\n", PORT);

    // Accept client connection
    childid = accept(socid, NULL, NULL);

    if (childid < 0)
    {
        printf("Client not connected\n");
        close(socid);
        return 1;
    }

    printf("Connected to client\n");

    while (1)
    {
        // Receive message from client
        n = recv(childid, msg, SIZE - 1, 0);

        if (n <= 0)
        {
            break;
        }

        msg[n] = '\0';

        printf("Client: %s\n", msg);

        // Check for exit
        if (strcmp(msg, "exit") == 0)
        {
            break;
        }

        // Server sends reply
        printf("Server: ");
        fgets(msg, SIZE, stdin);

        msg[strcspn(msg, "\n")] = '\0';

        send(childid, msg, strlen(msg) + 1, 0);

        if (strcmp(msg, "exit") == 0)
        {
            break;
        }
    }

    printf("Server disconnected from client\n");

    close(childid);
    close(socid);

    return 0;
}


#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 1024

int main()
{
    int socid, ac;
    struct sockaddr_in addr;
    char msg[SIZE];
    ssize_t n;

    // Create socket
    socid = socket(AF_INET, SOCK_STREAM, 0);

    if (socid < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    // Configure server address
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);
    addr.sin_addr.s_addr = INADDR_ANY;

    // Bind socket
    if (bind(socid, (struct sockaddr *)&addr,
             sizeof(addr)) < 0)
    {
        perror("Bind failed");
        close(socid);
        return 1;
    }

    // Listen for clients
    if (listen(socid, 5) < 0)
    {
        perror("Listen failed");
        close(socid);
        return 1;
    }

    printf("Server listening on port %d\n", PORT);

    // Iterative server
    while (1)
    {
        ac = accept(socid, NULL, NULL);

        if (ac < 0)
        {
            perror("Accept failed");
            continue;
        }

        printf("Client connected\n");

        // Chat with this client
        while (1)
        {
            n = recv(ac, msg, SIZE - 1, 0);

            if (n <= 0)
            {
                if (n == 0)
                    printf("Client disconnected\n");
                else
                    perror("Receive failed");

                break;
            }

            msg[n] = '\0';
            printf("Client: %s\n", msg);

            if (strcmp(msg, "exit") == 0)
                break;

            printf("Server: ");
            if (fgets(msg, SIZE, stdin) == NULL)
                break;

            msg[strcspn(msg, "\n")] = '\0';

            if (send(ac, msg, strlen(msg), 0) < 0)
            {
                perror("Send failed");
                break;
            }

            if (strcmp(msg, "exit") == 0)
                break;
        }

        close(ac);
        printf("Client connection closed\n");
    }

    close(socid);
    return 0;
}


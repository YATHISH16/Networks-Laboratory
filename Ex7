#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/time.h>

#define PORT 5000
#define SIZE 512
#define MAX_RETRIES 3

int main()
{
    int sockfd;
    struct sockaddr_in serverAddr;
    struct timeval timeout;
    socklen_t addrLen;
    char request[SIZE], response[SIZE];
    int choice, id;
    int requestId = 1;
    int attempts, received, n;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket");
        return 1;
    }

    memset(&serverAddr, 0, sizeof(serverAddr));

    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &serverAddr.sin_addr);

    timeout.tv_sec = 2;
    timeout.tv_usec = 0;

    setsockopt(sockfd, SOL_SOCKET, SO_RCVTIMEO,
               &timeout, sizeof(timeout));

    while (1)
    {
        printf("\n--- LIBRARY MANAGEMENT ---\n");
        printf("1. View available books\n");
        printf("2. Search for a book\n");
        printf("3. Issue a book\n");
        printf("4. Return a book\n");
        printf("5. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1)
            break;

        if (choice == 5)
            break;

        if (choice == 1)
        {
            sprintf(request, "%d LIST", requestId);
        }
        else if (choice >= 2 && choice <= 4)
        {
            printf("Enter book ID (1-5): ");

            if (scanf("%d", &id) != 1)
                break;

            if (choice == 2)
                sprintf(request, "%d SEARCH %d", requestId, id);
            else if (choice == 3)
                sprintf(request, "%d ISSUE %d", requestId, id);
            else
                sprintf(request, "%d RETURN %d", requestId, id);
        }
        else
        {
            printf("Invalid choice\n");
            continue;
        }

        received = 0;

        for (attempts = 1; attempts <= MAX_RETRIES; attempts++)
        {
            printf("Sending request %d (attempt %d)\n",
                   requestId, attempts);

            sendto(sockfd, request, strlen(request), 0,
                   (struct sockaddr *)&serverAddr,
                   sizeof(serverAddr));

            addrLen = sizeof(serverAddr);

            n = recvfrom(sockfd, response, SIZE - 1, 0,
                         (struct sockaddr *)&serverAddr,
                         &addrLen);

            if (n >= 0)
            {
                response[n] = '\0';
                received = 1;
                break;
            }

            printf("Timeout! Waiting to retransmit...\n");
        }

        if (received)
        {
            printf("ACK received for request %d\n", requestId);
            printf("Server response:\n%s\n", response);
            requestId++;
        }
        else
        {
            printf("Request failed after %d attempts.\n",
                   MAX_RETRIES);

            /*
              Keep the same request ID so the next attempt
              for this operation can be deduplicated.
              The user should retry the same operation.
            */
        }
    }

    close(sockfd);
    return 0;
}


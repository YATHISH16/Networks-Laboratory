#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define SIZE 1024

int main()
{
    int childid;
    struct sockaddr_in addr;
    char msg[SIZE];
    int n;

    // Create socket
    childid = socket(AF_INET, SOCK_STREAM, 0);

    if (childid < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    // Fill server address structure
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);

    // Server IP address
    inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);

    // Connect to server
    if (connect(childid, (struct sockaddr *)&addr, sizeof(addr)) < 0)
    {
        printf("Connection failed\n");
        close(childid);
        return 1;
    }

    printf("Connected to server\n");

    while (1)
    {
        // Client sends message
        printf("Client: ");
        fgets(msg, SIZE, stdin);

        msg[strcspn(msg, "\n")] = '\0';

        send(childid, msg, strlen(msg) + 1, 0);

        // Check for exit
        if (strcmp(msg, "exit") == 0)
        {
            break;
        }

        // Receive server reply
        n = recv(childid, msg, SIZE - 1, 0);

        if (n <= 0)
        {
            break;
        }

        msg[n] = '\0';

        printf("Server: %s\n", msg);

        if (strcmp(msg, "exit") == 0)
        {
            break;
        }
    }

    printf("Client disconnected\n");

    close(childid);

    return 0;
}


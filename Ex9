#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <signal.h>

#define PORT 5000
#define BUFFER_SIZE 4096
#define NAME_SIZE 256

int send_all(int sock, const void *data, size_t size)
{
    const char *p = data;
    size_t sent = 0;

    while (sent < size)
    {
        ssize_t n = send(sock, p + sent, size - sent, 0);

        if (n <= 0)
            return -1;

        sent += n;
    }

    return 0;
}

int recv_exact(int sock, void *data, size_t size)
{
    char *p = data;
    size_t received = 0;

    while (received < size)
    {
        ssize_t n = recv(sock, p + received,
                         size - received, 0);

        if (n <= 0)
            return -1;

        received += n;
    }

    return 0;
}

int read_line(int sock, char *buf, size_t size)
{
    size_t i = 0;
    char c;

    while (i < size - 1)
    {
        ssize_t n = recv(sock, &c, 1, 0);

        if (n <= 0)
            return -1;

        if (c == '\n')
            break;

        buf[i++] = c;
    }

    buf[i] = '\0';
    return 0;
}

/* Accept filenames only, not directory paths. */
int valid_filename(const char *name)
{
    if (name[0] == '\0' || strcmp(name, ".") == 0 ||
        strcmp(name, "..") == 0)
        return 0;

    if (strchr(name, '/') != NULL ||
        strchr(name, '\\') != NULL)
        return 0;

    return 1;
}

int send_file(int sock, FILE *fp, long long size)
{
    char buffer[BUFFER_SIZE];

    while (size > 0)
    {
        size_t amount = size > BUFFER_SIZE
                        ? BUFFER_SIZE : (size_t)size;

        size_t n = fread(buffer, 1, amount, fp);

        if (n == 0 || send_all(sock, buffer, n) < 0)
            return -1;

        size -= n;
    }

    return 0;
}

void handle_client(int ac)
{
    char choice[16];
    char filename[NAME_SIZE];
    char size_text[64];

    if (read_line(ac, choice, sizeof(choice)) < 0 ||
        read_line(ac, filename, sizeof(filename)) < 0)
        return;

    if (!valid_filename(filename))
    {
        send_all(ac, "ERR\n", 4);
        return;
    }

    if (strcmp(choice, "1") == 0)
    {
        /* Retrieve a file: server -> client */
        FILE *fp = fopen(filename, "rb");

        if (fp == NULL)
        {
            send_all(ac, "ERR\n", 4);
            return;
        }

        if (fseek(fp, 0, SEEK_END) != 0)
        {
            fclose(fp);
            send_all(ac, "ERR\n", 4);
            return;
        }

        long long size = (long long)ftell(fp);

        if (size < 0 || fseek(fp, 0, SEEK_SET) != 0)
        {
            fclose(fp);
            send_all(ac, "ERR\n", 4);
            return;
        }

        snprintf(size_text, sizeof(size_text),
                 "OK %lld\n", size);

        if (send_all(ac, size_text, strlen(size_text)) < 0)
        {
            fclose(fp);
            return;
        }

        send_file(ac, fp, size);
        fclose(fp);

        printf("File sent to client: %s\n", filename);
    }
    else if (strcmp(choice, "2") == 0)
    {
        /* Receive a file: client -> server */
        if (read_line(ac, size_text, sizeof(size_text)) < 0)
            return;

        char *end;
        long long size = strtoll(size_text, &end, 10);

        if (end == size_text || *end != '\0' || size < 0)
        {
            send_all(ac, "ERR\n", 4);
            return;
        }

        FILE *fp = fopen(filename, "wb");

        if (fp == NULL)
        {
            send_all(ac, "ERR\n", 4);
            return;
        }

        /* Tell the client that the server is ready. */
        if (send_all(ac, "OK\n", 3) < 0)
        {
            fclose(fp);
            return;
        }

        char buffer[BUFFER_SIZE];
        long long remaining = size;
        int success = 1;

        while (remaining > 0)
        {
            size_t amount = remaining > BUFFER_SIZE
                            ? BUFFER_SIZE : (size_t)remaining;

            if (recv_exact(ac, buffer, amount) < 0)
            {
                success = 0;
                break;
            }

            if (fwrite(buffer, 1, amount, fp) != amount)
            {
                success = 0;
                break;
            }

            remaining -= amount;
        }

        if (fclose(fp) != 0)
            success = 0;

        if (success)
        {
            send_all(ac, "OK\n", 3);
            printf("File received from client: %s\n", filename);
        }
        else
        {
            remove(filename);
            send_all(ac, "ERR\n", 4);
        }
    }
    else
    {
        send_all(ac, "ERR\n", 4);
    }
}

int main()
{
    int socid, ac;
    struct sockaddr_in addr;

    signal(SIGCHLD, SIG_IGN);

    socid = socket(AF_INET, SOCK_STREAM, 0);

    if (socid < 0)
    {
        perror("Socket");
        return 1;
    }

    int opt = 1;
    setsockopt(socid, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);
    addr.sin_addr.s_addr = INADDR_ANY;

    if (bind(socid, (struct sockaddr *)&addr,
             sizeof(addr)) < 0)
    {
        perror("Bind");
        close(socid);
        return 1;
    }

    if (listen(socid, 5) < 0)
    {
        perror("Listen");
        close(socid);
        return 1;
    }

    printf("Server listening on port %d...\n", PORT);

    while (1)
    {
        ac = accept(socid, NULL, NULL);

        if (ac < 0)
        {
            perror("Accept");
            continue;
        }

        pid_t p = fork();

        if (p < 0)
        {
            perror("Fork");
            close(ac);
            continue;
        }

        if (p == 0)
        {
            close(socid);
            handle_client(ac);
            close(ac);
            _exit(0);
        }

        close(ac);
    }

    close(socid);
    return 0;
}

